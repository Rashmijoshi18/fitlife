PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fitlife
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRE=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── AI & External APIs ─────────────────────────────────────────────────────
# Google Gemini API key — obtain at https://aistudio.google.com/app/apikey
# NEVER expose this in frontend code or VITE_ env variables
GEMINI_API_KEY=

# YouTube Data API v3 key — obtain at https://console.cloud.google.com/
# Enable the "YouTube Data API v3" and create an API key with appropriate restrictions
# If not set, the app falls back to YouTube search links (no fake data)
YOUTUBE_API_KEY=
